#!/bin/sh
# dice-uninstall: takes DiceOS off this Pi and gives the screen back.
set -e
[ "$(id -u)" = 0 ] || { echo "Run it with sudo: sudo /opt/dice/bin/dice-uninstall"; exit 1; }
WHO=$(getent passwd 1000 | cut -d: -f1)
systemctl disable --now dice-update.timer dice-boot.service dice.service 2>/dev/null || true
systemctl stop "dice-session@$WHO.service" 2>/dev/null || true
rm -f /etc/systemd/system/dice.service /etc/systemd/system/dice-boot.service /etc/systemd/system/dice-session@.service /etc/systemd/system/dice-update.service /etc/systemd/system/dice-update.timer
rm -f /etc/pam.d/dice-session /etc/systemd/logind.conf.d/dice.conf
systemctl daemon-reload
if [ -f /var/lib/dice/display-managers ]; then
  while read -r dm; do systemctl enable "$dm"; done < /var/lib/dice/display-managers
  systemctl set-default graphical.target
fi
plymouth-set-default-theme -R spinner 2>/dev/null || true
# Deuce's brain (Ollama and its models), if it was set up from Settings
[ -f /etc/systemd/system/ollama.service ] && grep -q "Deuce's brain" /etc/systemd/system/ollama.service && /opt/dice/bin/dice-brain remove || true
# Shield's part of /etc/hosts, and SereneTab as the web browser
if [ -f /etc/hosts ] && grep -q '^# >>> DiceOS Shield' /etc/hosts; then
  sed -i '/^# >>> DiceOS Shield/,/^# <<< DiceOS Shield <<</d' /etc/hosts
fi
update-alternatives --remove x-www-browser /opt/dice/bin/dice-open 2>/dev/null || true
rm -f /usr/share/applications/serenetab.desktop /etc/chromium/policies/managed/dice-serenetab.json
[ -f /etc/xdg/mimeapps.list ] && sed -i '/=serenetab\.desktop$/d' /etc/xdg/mimeapps.list
rm -rf /usr/share/plymouth/themes/dice /usr/share/plymouth/themes/dice-heaven /usr/share/plymouth/themes/dice-traced /etc/dice /var/lib/dice /opt/dice.old /run/dice
echo "DiceOS is off this Pi. /opt/dice goes next; restart afterwards: sudo reboot"
rm -rf /opt/dice
