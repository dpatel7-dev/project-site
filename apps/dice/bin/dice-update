#!/bin/sh
# dice-update: gets the newest DiceOS from the website and swaps it in.
#   dice-update          update now
#   dice-update --auto   only if automatic updates are on (the weekly timer uses this)
set -e
SITE=${DICE_SITE:-https://djp7.pythonanywhere.com}
if [ "$1" = "--auto" ] && ! python3 -c "import json,sys;sys.exit(0 if json.load(open('/etc/dice/settings.json')).get('updates',True) else 1)" 2>/dev/null; then
  echo "Automatic updates are off."; exit 0
fi
HAVE=$(cat /opt/dice/VERSION 2>/dev/null || echo 0)
# apps from the Dice Store get their updates too (quietly; it's fine if there are none)
if command -v flatpak >/dev/null 2>&1; then flatpak update --system -y --noninteractive >/dev/null 2>&1 || true; fi
NEW=$(curl -fsSL "$SITE/versions.json" | python3 -c "import json,sys;print(json.load(sys.stdin).get('dice',''))")
if [ -z "$NEW" ]; then echo "Couldn't reach $SITE to check for updates."; exit 1; fi
if [ "$NEW" = "$HAVE" ] && [ "$1" != "--force" ]; then echo "DiceOS $HAVE is the newest."; exit 0; fi
echo "Updating DiceOS $HAVE to $NEW..."
TMP=$(mktemp -d)
curl -fsSL "$SITE/dice/dice.tar.gz" | tar -xz -C "$TMP"
[ -f "$TMP/dice/daemon/diced.py" ] || { echo "The download wasn't right; nothing changed."; rm -rf "$TMP"; exit 1; }
rm -rf /opt/dice.old
mv /opt/dice /opt/dice.old
mv "$TMP/dice" /opt/dice
chmod +x /opt/dice/bin/*
rm -rf "$TMP"
systemctl restart dice.service
echo "Done. DiceOS $NEW is in. Restart the desktop to see it (Settings, Power, Restart desktop)."
