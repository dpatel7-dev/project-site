[Unit]
Description=Dice start-up (applies dice.json, then starts the desktop)
After=local-fs.target NetworkManager.service userconfig.service live-config.service systemd-user-sessions.service dice.service
Wants=dice.service

[Service]
Type=oneshot
ExecStart=/opt/dice/bin/dice-boot
TimeoutStartSec=180
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
